package components

templ VideoPlayerContent(roomCode string) {
    <style>
        #player {
            pointer-events: none;
            width: 100%;
            height: 62vh;
        }

        #playerWrap:fullscreen #player {
            height: 100vh;
        }
    </style>
    <div style="display:flex; gap:16px; padding:8px; height:90vh; overflow:hidden; box-sizing:border-box;">

        <!-- LEFT SIDE -->
        <div style="flex:1; display:flex; flex-direction:column; gap:12px; min-width:0; min-height:0; overflow:hidden;">

            <!-- PLAYER WRAPPER -->
            <div id="playerWrap" style="position:relative; width:100%; background:black; border-radius:12px; overflow:hidden; flex-shrink:0;">

                <div id="videoContainer">
                    

                    <div id="player"></div>
                </div>

                <!-- CONTROLS OVERLAY -->
                <div style="position:absolute; left:0; right:0; bottom:0; padding:8px 12px 12px; background:linear-gradient(transparent, rgba(0,0,0,.85)); display:flex; flex-direction:column; gap:8px;">

                    <input id="timeline" type="range" min="0" max="100" value="0" style="width:100%; cursor:pointer;"/>

                    <div style="display:flex; align-items:center; justify-content:space-between;">

                        <div style="display:flex; gap:8px;">
                            <button style="background:rgba(255,255,255,.2); color:#fff; border:none; border-radius:6px; padding:5px 12px; cursor:pointer; font-size:13px;"
                                hx-on:click="ytPlayer.playVideo(); sendVideoMessage({type:'play', currentTime:ytPlayer.getCurrentTime(), sendAt:Date.now()});">
                                ▶ Play
                            </button>
                            <button style="background:rgba(255,255,255,.2); color:#fff; border:none; border-radius:6px; padding:5px 12px; cursor:pointer; font-size:13px;"
                                hx-on:click="ytPlayer.pauseVideo(); sendVideoMessage({type:'pause', currentTime:ytPlayer.getCurrentTime(), sendAt:Date.now()});">
                                ⏸ Pause
                            </button>
                            <button style="background:rgba(255,255,255,.2); color:#fff; border:none; border-radius:6px; padding:5px 12px; cursor:pointer; font-size:13px;"
                                hx-on:click="const t = Math.max(0,ytPlayer.getCurrentTime()-10);ytPlayer.seekTo(t,true);sendVideoMessage({type:'seek', currentTime:t, sendAt:Date.now()});">
                                -10s
                            </button>
                            <button style="background:rgba(255,255,255,.2); color:#fff; border:none; border-radius:6px; padding:5px 12px; cursor:pointer; font-size:13px;"
                                hx-on:click="const t = Math.max(0,ytPlayer.getCurrentTime()+10);ytPlayer.seekTo(t,true);sendVideoMessage({type:'seek', currentTime:t, sendAt:Date.now()});">
                                +10s
                            </button>
                        </div>

                        <button id="fsBtn" style="background:rgba(255,255,255,.2); color:#fff; border:none; border-radius:6px; padding:5px 12px; cursor:pointer; font-size:13px;"
                            hx-on:click="toggleFullscreen()">
                            ⛶ Fullscreen
                        </button>

                    </div>
                </div>
            </div>

            <!-- PARTICIPANTS -->
            <div style="border:1px solid #ccc; border-radius:12px; padding:10px 12px; background:#fff; flex-shrink:0;">
                <h3 style="margin:0 0 8px 0; font-size:13px; font-weight:500; color:#888; text-transform:uppercase; letter-spacing:.04em;">Participants</h3>
                <div id="videos" style="display:flex; flex-direction:row; flex-wrap:nowrap; gap:8px; overflow-x:auto;">
                    <video id="local" autoplay muted playsinline
                        style="width:220px; min-width:220px; aspect-ratio:16/9; object-fit:cover; background:black; border-radius:8px;height:20vh">
                    </video>
                </div>
            </div>

        </div>

        <!-- CHAT: height:100% + min-height:0 makes it respect the parent 100vh -->
        <div style="width:280px; min-width:280px; max-width:280px; height:100%; min-height:0; border:1px solid #ccc; border-radius:12px; display:flex; flex-direction:column; overflow:hidden; background:#fff; flex-shrink:0;">

            <div style="padding:10px 14px; border-bottom:1px solid #eee; font-size:13px; font-weight:500; color:#888; text-transform:uppercase; letter-spacing:.04em; flex-shrink:0;">
                Chat
            </div>

            <!-- flex:1 + min-height:0 + overflow-y:auto = scrolls inside, never grows past parent -->
            <div id="chatMessages" style="flex:1; min-height:0; overflow-y:auto; padding:10px; display:flex; flex-direction:column; gap:8px;">
            </div>

            <div style="display:flex; border-top:1px solid #eee; flex-shrink:0;">
                <input id="chatInput" placeholder="Type a message..." style="flex:1; border:none; padding:10px; outline:none; font-size:14px;"/>
                <button id="sendChat" style="border:none; background:none; padding:10px 14px; cursor:pointer; font-weight:500; color:#555;">Send</button>
            </div>

        </div>

    </div>

    <script>
        let ytPlayer = null;
        let playerReady = false;
        const ROOM_CODE = "{{roomCode}}";
        sessionStorage.setItem("room_code",ROOM_CODE)
        const protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
        const socket = new WebSocket(`${protocol}//${window.location.host}/ws?code=${ROOM_CODE}`);

        const playerDiv = document.getElementById("player");
        const timeline     = document.getElementById("timeline");
        const chatMessages = document.getElementById("chatMessages");
        const chatInput    = document.getElementById("chatInput");
        const disconnectButton = document.getElementById("end");

        let isSeeking = false;

        socket.onopen  = () => console.log("Connected");
        socket.onerror = (err) => console.log(err);
        socket.onclose = () => console.log("Disconnected");
        
        function leaveroom(){
            sessionStorage.removeItem("room_code")
            socket.close()
            ws.close()
            window.location.href = "/";
        }
        let ytReady = false;

        function onYouTubeIframeAPIReady() {
            ytReady = true;
            console.log("YouTube API Ready");
        }
        function send(msg) {
            if (socket.readyState === WebSocket.OPEN) {
                socket.send(JSON.stringify(msg));
            }
        }

        function sendVideoMessage(video) {
            send({ videomessage: video, chatmessage: null });
        }

        function sendChatMessage(text) {
            send({ videomessage: null, chatmessage: { user: "Anonymous", message: text } });
        }

        function appendChat(user, message) {
            const div = document.createElement("div");
            div.style.cssText = "padding:8px; border-radius:8px; background:#f0f0f0; font-size:13px; line-height:1.5; flex-shrink:0;";
            div.innerHTML = `<b>${user}</b><br>${message}`;
            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function toggleFullscreen() {
            const wrap = document.getElementById("playerWrap");
            const btn  = document.getElementById("fsBtn");
            if (!document.fullscreenElement) {
                wrap.requestFullscreen();
                btn.textContent = "✕ Exit";
            } else {
                document.exitFullscreen();
                btn.textContent = "⛶ Fullscreen";
            }
        }

        document.addEventListener("fullscreenchange", () => {
            const btn = document.getElementById("fsBtn");

            if (!document.fullscreenElement) {
                btn.textContent = "⛶ Fullscreen";
                playerDiv.style.maxHeight = "62vh";
            } else {
                playerDiv.style.maxHeight = "100vh";
            }
        });

        socket.onmessage = (event) => {
            const msg = JSON.parse(event.data);
            console.log("RAW:", event.data);

            if (msg.type === 'heartbeat') {
                if (!ytPlayer) return;
                if (msg.isPlaying == true) {
                    let timeinterval= (Date.now() - msg.sendAt)/1000 ;
                    const serverTime = msg.currentTime + timeinterval;
                    const localTime = ytPlayer.getCurrentTime();
                    const diff = Math.abs(serverTime - localTime);
                    console.log("diff:",diff)
                    if (diff > 2) {
                        ytPlayer.seekTo(serverTime, true);
                        ytPlayer.playVideo();
                    }
                    console.log("heartbeat playing");
                } 
                else {
                    setTimeout(() => {
                        ytPlayer.pauseVideo();
                    }, 100);
                    ytPlayer.seekTo(
                        msg.currentTime,
                        true
                    );
                    console.log("playercurrenttime:", ytPlayer.getCurrentTime());
                }
                return; // Added this return to exit after heartbeat
            }

            if (msg.chatmessage) {
                appendChat(msg.chatmessage.user, msg.chatmessage.message);
                return;
            }

            if (!msg.videomessage) return;
            const video = msg.videomessage;

            if (video.type === "sync") {
                console.log("video msg for sync", video);
                console.log("raw", msg);
                if (!ytPlayer && video.video_url) {
                    if (!ytReady) {
                        setTimeout(() => {
                            if (!ytPlayer && ytReady) {
                                createPlayer(video.video_url);
                            }
                        }, 500);
                        return;
                    }
                    createPlayer(video.video_url);
                }

                if (!ytPlayer) return;
                if (video.isPlaying) {
                    console.log("is playing is called");
                    const delay = (Date.now() - video.sendAt) / 1000;
                    ytPlayer.seekTo(
                        video.currentTime + delay,
                        true
                    );
                    ytPlayer.playVideo();
                } else {
                    ytPlayer.seekTo(
                        video.currentTime,
                        true
                    );
                    ytPlayer.pauseVideo();
                }
            } else if (video.type === "play") {
                if (!ytPlayer) return;
                const delay = (Date.now() - video.sendAt) / 1000;
                ytPlayer.seekTo(
                    video.currentTime + delay,
                    true
                );
                ytPlayer.playVideo();
            } else if (video.type === "pause") {
                if (!ytPlayer) return;
                ytPlayer.seekTo(
                    video.currentTime,
                    true
                );
                ytPlayer.pauseVideo();
            } else if (video.type === "seek") {
                if (!ytPlayer) return;
                isSeeking = true;
                const wasPaused =
                    ytPlayer.getPlayerState() !== YT.PlayerState.PLAYING;

                ytPlayer.seekTo(video.currentTime, true);

                if (wasPaused) {
                    setTimeout(() => {
                        ytPlayer.pauseVideo();
                    }, 100);
                }
                isSeeking = false;
            } else if (video.type === "video_change") {
                if (video.video_url) {
                    createPlayer(video.video_url);
                }
            }
        };

        setInterval(() => {
            if (!ytPlayer) return;
            if (!playerReady) return;
            const duration = ytPlayer.getDuration();
            const current = ytPlayer.getCurrentTime();

            if (!duration) return;

            timeline.value = (current / duration) * 100;
        }, 250); // Added missing closing parenthesis and semicolon

        timeline.addEventListener("change", () => {

            if (!ytPlayer) return;

            const time =
                (timeline.value / 100) *
                ytPlayer.getDuration();

            ytPlayer.seekTo(time, true);

            sendVideoMessage({
                type: "seek",
                currentTime: time,
                sendAt: Date.now()
            });
        });

        document.getElementById("sendChat").addEventListener("click", () => {
            const text = chatInput.value.trim();
            if (!text) return;
            sendChatMessage(text);
            chatInput.value = "";
        });

        chatInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") document.getElementById("sendChat").click();
        });

        function createPlayer(videoId) {

            if (!ytPlayer) {

                ytPlayer = new YT.Player("player", {
                    height: "100%",
                    width: "100%",
                    videoId: videoId,
                    events: {
                        onReady: (event) => {
                            console.log("player ready");
                            playerReady = true;
                            event.target.pauseVideo()
                            event.target.seekTo(0,true)
                        },
                        onStateChange: onPlayerStateChange

                    },
                    playerVars: {
                        controls: 0,
                        modestbranding: 1,
                        rel: 0,
                        fs: 0,
                        disablekb: 1
                    }
                });

                return;
            }

            ytPlayer.cueVideoById(videoId);

            setTimeout(() => {
                    playerReady = true;
                }, 500);
        }

        function onPlayerStateChange(event) {

                if (event.data === YT.PlayerState.ENDED) {

                    sendVideoMessage({
                        type: "pause",
                        currentTime: ytPlayer.getDuration(),
                        sendAt: Date.now()
                    });

                    ytPlayer.pauseVideo();
                }
            }
        
        function extractVideoId(url) {

            const regex =
                /(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&?/]+)/;

            const match = url.match(regex);

            return match ? match[1] : null;
        }

        document.getElementById("loadVideoBtn")
            .addEventListener("click", () => {

                const url = document.getElementById("youtubeUrl").value;

                const videoId = extractVideoId(url);

                if (!videoId) {
                    alert("Invalid URL");
                    return;
                }
                createPlayer(videoId); 
                sendVideoMessage({
                    type: "video_change",
                    video_url: videoId,
                    sendAt: Date.now()
                });
            });
        document.addEventListener("keydown", (e) => {

            if (
                e.target.tagName === "INPUT" ||
                e.target.tagName === "TEXTAREA"
            ) {
                return;
            }

            if (e.code !== "Space") return;

            e.preventDefault();

            if (!ytPlayer || !playerReady) return;

            if (ytPlayer.getPlayerState() === YT.PlayerState.PLAYING) {

                ytPlayer.pauseVideo();

                sendVideoMessage({
                    type: "pause",
                    currentTime: ytPlayer.getCurrentTime(),
                    sendAt: Date.now()
                });

            } else {

                ytPlayer.playVideo();

                sendVideoMessage({
                    type: "play",
                    currentTime: ytPlayer.getCurrentTime(),
                    sendAt: Date.now()
                });
            }
        });
    </script>
    <script src="/static/js/index.js"></script>
}
