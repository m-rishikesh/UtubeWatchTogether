package components

templ Home() {
    @Base("Watch Party") {
        <div
            style="
                display:flex;
                justify-content:center;
                align-items:center;
                min-height:100vh;
                background:#fafafa;
            "
        >
                <div id="rejoinModal"
                    style="display:none;
                    position:fixed;
                    inset:0;
                    background:rgba(0,0,0,.5);
                    justify-content:center;
                    align-items:center;">

                    <div
            style="
                background:#fff;
                color:#000;
                width:min(90vw, 520px);
                padding:40px;
                border:3px solid #000;
                border-radius:16px;
                box-shadow:0 10px 30px rgba(0,0,0,.15);
                text-align:center;
                display:flex;
                flex-direction:column;
                gap:24px;
            "
        >
            <div>
                <h2
                    style="
                        font-size:2rem;
                        font-weight:700;
                        margin:0 0 12px 0;
                        letter-spacing:-1px;
                    "
                >
                    Rejoin Room?
                </h2>

                <p
                    style="
                        font-size:1.1rem;
                        color:#444;
                        line-height:1.6;
                        margin:0;
                    "
                >
                    You were previously connected to room
                    <br>
                    <span
                        id="roomCodeText"
                        style="
                            display:inline-block;
                            margin-top:12px;
                            font-size:1.8rem;
                            font-weight:700;
                            letter-spacing:6px;
                            color:#000;
                        "
                    >
                    </span>
                </p>
            </div>

            <div
                style="
                    display:flex;
                    gap:12px;
                    justify-content:center;
                "
            >
                <button
                    id="rejoinBtn"
                    style="
                        flex:1;
                        max-width:180px;
                        padding:14px 24px;
                        background:#000;
                        color:#fff;
                        border:none;
                        border-radius:10px;
                        font-size:1rem;
                        font-weight:600;
                        cursor:pointer;
                    "
                >
                    Rejoin
                </button>

                <button
                    id="cancelBtn"
                    style="
                        flex:1;
                        max-width:180px;
                        padding:14px 24px;
                        background:#fff;
                        color:#000;
                        border:2px solid #000;
                        border-radius:10px;
                        font-size:1rem;
                        font-weight:600;
                        cursor:pointer;
                    "
                >
                    Cancel
                </button>
            </div>
        </div>
        </div>
            <div
                style="
                    text-align:center;
                    max-width:400px;
                    width:100%;
                    padding:40px 20px;
                "
            >
                <h1 style="font-size:2.5em; margin-bottom:10px; font-weight:300; letter-spacing:-0.5px;">Watch Party</h1>
                <p style="color:#666; font-size:1em; margin-bottom:40px; font-weight:300;">Synchronized video experience</p>

                <div style="display:flex; flex-direction:column; gap:12px;">
                    <button
                        type="button"
                        hx-post="/create-room"
                        hx-target="body"
                        hx-swap="innerHTML"
                        style="
                            padding:14px 28px;
                            font-size:1em;
                            background:#000;
                            color:#fff;
                            border:none;
                            border-radius:6px;
                            cursor:pointer;
                            font-weight:500;
                            transition:all 0.2s;
                        "
                        onmouseover="this.style.background='#333'"
                        onmouseout="this.style.background='#000'"
                    >
                        Create Room
                    </button>

                    <button
                        type="button"
                        hx-get="/join-room-form"
                        hx-target="body"
                        hx-swap="innerHTML"
                        style="
                            padding:14px 28px;
                            font-size:1em;
                            background:#f5f5f5;
                            color:#000;
                            border:1px solid #e0e0e0;
                            border-radius:6px;
                            cursor:pointer;
                            font-weight:500;
                            transition:all 0.2s;
                        "
                        onmouseover="this.style.background='#efefef'"
                        onmouseout="this.style.background='#f5f5f5'"
                    >
                        Join Room
                    </button>
                </div>
            </div>
        </div>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const roomCode = sessionStorage.getItem("room_code");

                if (!roomCode) return;

                document.getElementById("rejoinModal").style.display = "flex";
                document.getElementById("roomCodeText").textContent = roomCode;
            });
            document.getElementById("rejoinBtn")
                .addEventListener("click", () => {

                    const roomCode =
                        sessionStorage.getItem("room_code");

                    htmx.ajax(
                        "GET",
                        `/auto-join?code=${roomCode}`,
                        {
                            target: "body",
                            swap: "innerHTML",
                        }
                    );
                });
            document.getElementById("cancelBtn")
                .addEventListener("click", () => {

                    sessionStorage.removeItem("room_code");

                    document.getElementById("rejoinModal")
                        .style.display = "none";
                });
        </script>
    }
}

