package components

templ VideoPlayer() {
    @Base("Home") {

        <div
            hx-ext="ws"
            ws-connect="/ws"

            style="
                display:flex;
                flex-direction:column;
                align-items:center;
                gap:16px;
                padding:20px;
            "
        >

            <video
                id="player"
                width="480"
                height="480"
                style="
                    border-radius:12px;
                    background:black;
                "
            >
                <source src="/static/tuf_bug.mp4" type="video/mp4">
            </video>

            <input
                id="timeline"
                type="range"
                min="0"
                max="100"
                value="0"

                style="
                    width:480px;
                    cursor:pointer;
                "
            />

            <div
                style="
                    display:flex;
                    gap:12px;
                    flex-wrap:wrap;
                    justify-content:center;
                "
            >

                <button
                    hx-on:click="
                        player.play();
                    "
                >
                    Play
                </button>

                <button
                    hx-on:click="
                        player.pause();
                    "
                >
                    Pause
                </button>

                <button
                    hx-on:click="
                        player.currentTime += 10;
                        send({type: 'seek', currentTime: player.currentTime});
                    "
                >
                    +10s
                </button>

                <button
                    hx-on:click="
                        player.currentTime -= 10;
                        send({type: 'seek', currentTime: player.currentTime});
                    "
                >
                    -10s
                </button>

            </div>

            <script>
                const protocol = window.location.protocol === "https:"
                    ? "wss:"
                    : "ws:";

                const socket = new WebSocket(
                `${protocol}//${window.location.host}/ws`
                );
                const player = document.getElementById('player');
                const timeline = document.getElementById('timeline');
                let isSeeking = false;

                socket.onopen = () => {
                    console.log("WebSocket Connected");
                };

                socket.onmessage = (event) => {
                    const msg = JSON.parse(event.data);
                    console.log("Received:", event.data);

                    if (msg.type === "sync") {
                        // Sync to server's current time
                        
                        if (msg.isPlaying && typeof msg.currentTime === 'number' && isFinite(msg.currentTime)) {
                            val = (Date.now() - msg.sendAt)/1000
                            console.log(val)
                            diff = msg.currentTime + val
                            player.currentTime = msg.currentTime + val;
                        }else{
                            player.currentTime = msg.currentTime
                        }
                        
                        console.log("Synced - Server Time:", msg.currentTime, "Playing:", msg.isPlaying);
                        
                        if (msg.isPlaying) {
                            player.play();
                        } else {
                            
                            player.pause();
                        }
                    } else if (msg.type === "play") {
                        if (typeof msg.currentTime === 'number' && isFinite(msg.currentTime)) {
                            val = (Date.now() - msg.sendAt)/1000
                            console.log(val)
                            
                            player.currentTime = msg.currentTime + val;
                            }
                        player.play();
                    } else if (msg.type === "pause") {
                        if (typeof msg.currentTime === 'number' && isFinite(msg.currentTime)) {
                            val = (Date.now() - msg.sendAt)/1000
                            console.log(val)
                            player.currentTime = msg.currentTime + val;
                            }
                        player.pause();
                    } else if (msg.type === "seek") {
                        isSeeking = true;
                        if (typeof msg.currentTime === 'number' && isFinite(msg.currentTime)) {
                            player.currentTime = msg.currentTime;
                        }
                        isSeeking = false;
                    }
                };

                socket.onerror = (error) => {
                    console.error("WebSocket Error:", error);
                };

                socket.onclose = () => {
                    console.log("WebSocket Disconnected");
                };

                // Send play event
                player.addEventListener('play', () => {
                    if (!isSeeking) {
                        send({type: "play",currentTime:player.currentTime,sendAt:Date.now()});
                    }
                });

                // Send pause event
                player.addEventListener('pause', () => {
                    if (!isSeeking) {
                        send({type: "pause",currentTime:player.currentTime,sendAt:Date.now()});
                    }
                });

                // Update timeline during playback
                player.addEventListener('timeupdate', () => {
                    if (!isSeeking) {
                        const percent = (player.currentTime / player.duration) * 100;
                        timeline.value = percent;
                    }
                });

                function send(msg) {
                    if (socket.readyState === WebSocket.OPEN) {
                        socket.send(JSON.stringify(msg));
                    }
                }

                // Timeline seek
                timeline.addEventListener('change', () => {
                    player.currentTime = (timeline.value / 100) * player.duration;
                    send({type: "seek", currentTime: player.currentTime,sendAt:Date.now()});
                });
            </script>

        </div>
    }
}